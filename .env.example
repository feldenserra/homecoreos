# ---------------------------------------------------------------------------
# Client (bundled into the app — EXPO_PUBLIC_* is readable by anyone who has
# the binary, so only ever put values here that are safe to publish)
# ---------------------------------------------------------------------------

# Supabase project URL and publishable/anon key. Both are public by design:
# row-level security, not key secrecy, is what protects the data.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to false to hide the sign-in and sign-up entry points (marketing-only
# mode). This only hides UI; to actually stop signups, disable the providers in
# the Supabase dashboard.
EXPO_PUBLIC_ALLOW_LOGINS=


# ---------------------------------------------------------------------------
# Edge Function secrets — NEVER prefix these with EXPO_PUBLIC_.
# Set with: supabase secrets set KEY=value
# ---------------------------------------------------------------------------

# AES-256-GCM key for chat content, conversation titles/prompts, and stored AI
# provider credentials (32 bytes, base64).
#   openssl rand -base64 32
# If this leaks, every encrypted column is readable. If it is lost, they are
# not recoverable.
CHAT_CONTENT_ENCRYPTION_KEY=

# Optional comma-separated hostnames allowed to be reached over plain http by
# the chat function. Everything else must be https, and private, loopback and
# link-local ranges are always refused. Leave empty unless you are tunnelling a
# self-hosted Ollama over http.
AI_ALLOW_INSECURE_HOSTS=

# GitHub OAuth app credentials, read by supabase/config.toml for the local
# stack. In hosted, set these under Auth > Providers instead. The GitHub app's
# callback URL is https://<project-ref>.supabase.co/auth/v1/callback.
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=


# ---------------------------------------------------------------------------
# Migrations only (drizzle-kit generate / studio). Not used at runtime.
# ---------------------------------------------------------------------------

# Supabase DIRECT connection, not the transaction pooler — pooled connections
# cannot run DDL reliably.
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Local stack:
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:54322/postgres
