# App env only — never put server secrets here (they ship in the binary).
#
#   cp .env.example .env
#   yarn start
#
# CHAT_CONTENT_ENCRYPTION_KEY is NOT set here:
#   Cloud:     supabase secrets set CHAT_CONTENT_ENCRYPTION_KEY=...
#   Self-host: auto-written to docker/supabase-project/.env by commission

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to false to hide sign-in / sign-up UI (marketing-only). Does not disable
# providers on the server — do that in the Supabase dashboard.
EXPO_PUBLIC_ALLOW_LOGINS=true

# Self-host / local: hides GitHub OAuth on the login screen (not configured
# in the Docker stack). Leave unset or false for cloud / production builds.
EXPO_PUBLIC_IS_LOCAL=true
