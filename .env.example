POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=app_local
# App runtime role (RLS enforced). Created by migration 0001.
# Used by the web container (hostname "db" on the compose network).
DATABASE_URL=postgres://app_runtime:password@db:5432/app_local
# Host-side app connection:
# DATABASE_URL=postgres://app_runtime:password@localhost:5432/app_local
# Migrations / drizzle-kit (superuser; bypasses RLS):
DATABASE_URL_MIGRATE=postgres://postgres:password@localhost:5432/app_local
AUTH_SECRET=your-super-secret-local-key
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# true: full app (/ redirects to /login). false: public landing at /; other
# routes redirect home. Production Docker inlines this at image build time
# (see Dockerfile ARG); yarn dev reads it from this file at runtime.
RUNNING_LOCAL=true

# AES-256-GCM key for chat message/title at-rest encryption (32 bytes, base64).
# Generate with: openssl rand -base64 32
CHAT_CONTENT_ENCRYPTION_KEY=

# AI / chat (OpenAI-compatible). Default: local Ollama.
# Switch with AI_PROVIDER=ollama | openai
AI_PROVIDER=ollama
AI_MODEL=llama3.2
# Ollama ignores the key but the OpenAI SDK requires a non-empty value.
AI_API_KEY=ollama
# OpenAI-compatible base path is /v1 (not Ollama's native /api).
# docker-compose.dev.yml uses host networking, so 127.0.0.1 reaches host Ollama.
AI_BASE_URL=http://127.0.0.1:11434/v1
# If the web container uses bridge networking instead, host.docker.internal only
# works when (1) Ollama listens on 0.0.0.0 (OLLAMA_HOST=0.0.0.0:11434) and
# (2) the host firewall allows Docker → host on 11434. Otherwise connections time out.
# AI_BASE_URL=http://host.docker.internal:11434/v1
# Recreate the web container after changing AI_* (compose env is set at create time).
# OpenAI cloud example:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=   # omit to use https://api.openai.com/v1
