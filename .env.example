POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=app_local

# Local Docker dev — app connects as postgres (RLS enforced via FORCE ROW LEVEL SECURITY).
DATABASE_URL=postgres://postgres:password@localhost:5432/app_local
DATABASE_URL_MIGRATE=postgres://postgres:password@localhost:5432/app_local

# Neon production — same owner user; migrate uses direct URL, app uses pooled URL on Vercel.
# DATABASE_URL_MIGRATE=postgresql://owner:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://owner:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

AUTH_SECRET=your-super-secret-local-key
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AES-256-GCM key for chat message/title at-rest encryption (32 bytes, base64).
# Generate with: openssl rand -base64 32
CHAT_CONTENT_ENCRYPTION_KEY=

# Set to false to disable /login, /signup, /app, and auth APIs (redirects to /).
# Unset or any other value leaves logins enabled.
ALLOW_LOGINS=
