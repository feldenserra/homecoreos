POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=app_local
# App runtime role (RLS enforced). Created by migration 0001.
# Used by the web container (hostname "db" on the compose network).
DATABASE_URL=postgres://app_runtime:password@db:5432/app_local
# Host-side app connection:
# DATABASE_URL=postgres://app_runtime:password@localhost:5432/app_local
# Migrations / drizzle-kit (superuser; bypasses RLS):
DATABASE_URL_MIGRATE=postgres://postgres:password@localhost:5432/app_local
AUTH_SECRET=your-super-secret-local-key
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
