# NOT for Docker Compose / open-core self-host.
# For compose, use: yarn compose:up  (copies docker/.env.example → .env)
#   or:            cp docker/.env.example .env && docker compose up --build
#
# This file is only for:
#   - Cloud / SaaS (hosted Supabase + Expo on the host)
#   - Native / CLI local stack (yarn supabase:start)
#
# Same HomeCore variable names as compose; different values and a much shorter
# set — the long JWT/Postgres/Realtime block lives only in docker/.env.example.
#
# Three ways to run:
#   1) Open-core self-host → yarn compose:up  (NOT this file)
#   2) Cloud / SaaS → copy this file to .env and set Cloud values below
#   3) Native / CLI → copy this file to .env, yarn supabase:start, paste anon key
# Do not run (1) and (3) at the same time.


# ---------------------------------------------------------------------------
# Client (bundled into the app — EXPO_PUBLIC_* is readable by anyone who has
# the binary, so only ever put values here that are safe to publish)
# ---------------------------------------------------------------------------

# --- CLI local (yarn supabase:start) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Paste anon/publishable key from `yarn supabase:status` after start.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android emulator → host CLI stack:
#   EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# Physical device on the same LAN:
#   EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321

# --- Cloud ---
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<project-anon-or-publishable-key>

# Set to false to hide the sign-in and sign-up entry points (marketing-only
# mode). This only hides UI; to actually stop signups, disable the providers in
# the Supabase dashboard (or leave enable_signup off in config.toml locally).
EXPO_PUBLIC_ALLOW_LOGINS=


# ---------------------------------------------------------------------------
# Edge Function secrets — NEVER prefix these with EXPO_PUBLIC_.
#
# CLI local: this file; `yarn supabase:functions` passes --env-file .env
# Cloud:     supabase secrets set KEY=value   (then yarn supabase:deploy)
# Compose:   docker/.env.example → root .env (via yarn compose:up)
# ---------------------------------------------------------------------------

# AES-256-GCM key for chat content, conversation titles/prompts, and stored AI
# provider credentials (32 bytes, base64).
#   openssl rand -base64 32
CHAT_CONTENT_ENCRYPTION_KEY=

# Optional comma-separated hostnames allowed over plain http by the chat
# function. Leave empty unless tunnelling a self-hosted Ollama over http.
AI_ALLOW_INSECURE_HOSTS=

# GitHub OAuth — CLI local stack only (read by supabase/config.toml).
# Local callback:  http://127.0.0.1:54321/auth/v1/callback
# Compose: enable via docker/supabase Auth env (see docker/.env.example).
# Cloud: set under Auth > Providers; callback is
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=


# ---------------------------------------------------------------------------
# Migrations only (drizzle-kit generate / studio). Not used at runtime.
# ---------------------------------------------------------------------------

# CLI local:
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Cloud (direct connection, not the transaction pooler):
# DATABASE_URL_MIGRATE=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
