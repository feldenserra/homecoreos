# App env only. Copy to `.env` after you have a commissioned Supabase.
#
#   cp .env.example .env
#   yarn start
#
# Backend setup is separate — see README (Cloud | Local CLI | Self-host).

# Public client config (safe to ship in the binary)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to false to hide sign-in / sign-up UI (marketing-only). Does not disable
# providers on the server — do that in the Supabase dashboard / config.
EXPO_PUBLIC_ALLOW_LOGINS=

# ---------------------------------------------------------------------------
# Local CLI commission only (yarn supabase:functions --env-file .env).
# Cloud:    supabase secrets set CHAT_CONTENT_ENCRYPTION_KEY=...
# Self-host: lives in docker/supabase-project/.env (created by selfhost init).
# ---------------------------------------------------------------------------
CHAT_CONTENT_ENCRYPTION_KEY=

# Optional: allow plain http to these hosts from the chat function (tunnels).
AI_ALLOW_INSECURE_HOSTS=

# GitHub OAuth for local CLI stack (supabase/config.toml). Cloud: dashboard.
# Callback local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# Drizzle generate/studio only — not used at app runtime.
# Local CLI:  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud:      postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:54322/postgres
