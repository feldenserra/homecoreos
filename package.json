{
  "name": "homecoreos",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint -c oxlint.config.mjs .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:push": "echo 'Use `yarn supabase:push`. Applying with drizzle-kit desyncs supabase_migrations.schema_migrations.' && exit 1",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:push": "supabase db push",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve --env-file .env",
    "supabase:deploy": "supabase functions deploy chat conversations ai-keys",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "types:generate": "supabase gen types typescript --local > lib/database.types.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
